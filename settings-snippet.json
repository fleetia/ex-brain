{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "__HOOK_PATH__",
            "timeout": 10,
            "statusMessage": "지식베이스 컨텍스트 로딩..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "__PII_HOOK_PATH__",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
